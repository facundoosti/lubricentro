{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(codegraph *)",
      "Bash(openspec *)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make logs*)",
      "Bash(make health)",
      "Bash(bundle exec rspec*)",
      "Bash(bundle exec rubocop*)",
      "Bash(bundle exec brakeman*)",
      "Bash(npm run lint*)",
      "Bash(npm run build)",
      "Bash(npx vitest run*)",
      "Bash(npm test -- --run*)",
      "Bash(node tools/qa-runner/run.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "mcp__codegraph__*"
    ],
    "ask": [
      "Bash(bin/rails db:migrate*)",
      "Bash(bundle exec rails db:migrate*)",
      "Bash(rails db:migrate*)",
      "Bash(make db-migrate*)",
      "Bash(railway *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.backup)",
      "Read(./backend/config/master.key)",
      "Read(./backend/config/credentials/*.key)",
      "Edit(./backend/db/schema.rb)",
      "Write(./backend/db/schema.rb)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(*db:drop*)",
      "Bash(*db:reset*)",
      "Bash(make db-reset*)",
      "Bash(rm -rf *)"
    ]
  },
  "enabledMcpjsonServers": ["codegraph"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 60 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-on-edit.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-affected-tests.sh", "timeout": 300 }
        ]
      }
    ]
  }
}
